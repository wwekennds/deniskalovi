<Window x:Class="Lab08App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список задач" Height="420" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: ввод, приоритет, кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBox x:Name="InputBox" Width="180"/>
            <ComboBox x:Name="PriorityBox" Width="60" SelectedIndex="0" Margin="4,0">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
            </ComboBox>
            <Button Content="Добавить" Click="AddButton_Click"/>
            <Button Content="Удалить" Click="DeleteButton_Click" Margin="4,0,0,0"/>
            <Button Content="Удалить выполненные"
                    Click="DeleteCompletedButton_Click"
                    Margin="4,0,0,0"/>
        </StackPanel>

        <!-- Список задач -->
        <!-- если ListBox заменить на DataGrid, то появятся три столбца с названиями идентичными свойствам класса TaskItem
        чтобы запретить редактирование столбцов, нужно установить IsReadOnly="True"-->
        <DataGrid x:Name="TaskList" Grid.Row="1" Margin="0,8" IsReadOnly="True">
            <DataGrid.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsDone}"
                                  Margin="0,0,8,0"
                                  Checked="Task_IsDoneChanged"
                                  Unchecked="Task_IsDoneChanged"/>
                        <TextBlock Text="{Binding Title}" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#222222"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Foreground" Value="#999999"/>
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Индикатор приоритета: 1 — зелёный, 2 — жёлтый, 3 — красный -->
                        <TextBlock Text="{Binding Priority, StringFormat='[{0}]'}"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Priority}" Value="1">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="2">
                                            <Setter Property="Foreground" Value="Goldenrod"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="3">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.ItemTemplate>
        </DataGrid>

        <!-- Нижняя надпись: счётчик + процент -->
        <TextBlock x:Name="CounterText" Grid.Row="2" FontWeight="Bold"/>
    </Grid>
</Window>
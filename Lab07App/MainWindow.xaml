<Window x:Class="Lab07App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор профиля" Height="480" Width="440"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

		<TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия:"/>
		<TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,8"
				 Text="{Binding LastName, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged,
                FallbackValue='— не задано —'}"/>

		<TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:"/>
		<TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,8"
				 Text="{Binding FirstName, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged,
                FallbackValue='— не задано —'}"/>

		<TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество:"/>
		<TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,8"
				 Text="{Binding Surname, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged,
                FallbackValue='— не задано —'}"/>

		<TextBlock Grid.Row="3" Grid.Column="0" Text="Email:"/>
		<TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,8"
				 Text="{Binding Email, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged,
                FallbackValue='— не задано —'}"/>

		<TextBlock Grid.Row="4" Grid.Column="0" Text="Телефон:"/>
		<TextBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,8"
				 Text="{Binding NumberPhone, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged,
                FallbackValue='— не задано —'}"/>

		<TextBlock Grid.Row="5" Grid.Column="0" Text="Возраст:"/>
		<Slider Grid.Row="5" Grid.Column="1" Minimum="14" Maximum="100"
				Value="{Binding Age, FallbackValue=14}" Margin="0,8"/>

		<GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
				  Header="Предпросмотр визитной карточки">
			<StackPanel Margin="8">
				<TextBlock Text="{Binding FullName, FallbackValue='Нет данных'}"
						   FontSize="20" FontWeight="Bold"/>
				<TextBlock Text="{Binding Initials, FallbackValue='—'}"
						   FontStyle="Italic"
						   Foreground="Gray"
						   Margin="0,2,0,8"/>
				<TextBlock>
					<Run Text="Возраст: "/>
					<Run Text="{Binding Age, FallbackValue='?'}"/>
				</TextBlock>
				<TextBlock>
					<Run Text="Email: "/>
					<Run Text="{Binding Email, FallbackValue='— не задано —'}"/>
				</TextBlock>
				<TextBlock>
					<Run Text="Телефон: "/>
					<Run Text="{Binding NumberPhone, FallbackValue='— не задано —'}"/>
				</TextBlock>
			</StackPanel>
		</GroupBox>

    </Grid>

	<!-- Задание 2(Объяснение): Если убрать UpdateSourceTrigger=PropertyChanged, то для TextBox по умолчанию используется режим LostFocus: источник обновляется 
	не при каждом нажатии клавиши, а только когда поле теряет фокус (клик по другому полю, Tab и т.п.). Из-за этого во время набора текста 
	свойства LastName, FirstName, Surname, Email и NumberPhone остаются прежними, и предпросмотр визитной карточки не обновляется — он 
	показывает старые значения, пока фокус не покинет текущее поле. Особенно это заметно на FullName и Initials: они пересчитываются только
	после потери фокуса, а не посимвольно. После возврата PropertyChanged поведение снова становится «живым»: каждое нажатие клавиши сразу 
	передаёт значение в источник, срабатывает OnPropertyChanged, и предпросмотр обновляется в реальном времени. Итог: разница только в 
	моменте обновления источника — с PropertyChanged при каждом изменении текста, без него (LostFocus) — только при потере фокуса.-->


	<!--Задание 3(Объяснение): FallbackValue задаёт значение, которое WPF подставляет, когда привязку невозможно разрешить
        (нет DataContext, нет свойства, ошибка в Path). При временном удалении DataContext все привязки
        теряют источник, и вместо пустых полей/ошибок в окне отображаются заранее заданные заглушки
        (— не задано —, Нет данных, ?). Это делает интерфейс устойчивым к отсутствию данных и удобным
        для отладки. Отличие от TargetNullValue: Fallback срабатывает при невозможности получить значение,
        TargetNull — когда значение получено, но равно null. -->

	</Window>
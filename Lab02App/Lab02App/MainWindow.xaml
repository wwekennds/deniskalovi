<Window x:Class="Lab02App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="420" Width="320"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <Border DockPanel.Dock="Bottom" Background="LightGray" Height="25" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Обычный режим" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           FontSize="12"
                           Margin="5,0,0,0"/>

                <Button Grid.Column="1" 
                        Content="Вход" 
                        Width="60" 
                        Height="22"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,1"
                        Click="OpenLoginWindow_Click"
                        FontSize="11"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBox Name ="Display_txtBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                     IsReadOnly="True" Text="0" FontSize="20"
                     TextAlignment="Right" Margin="0,0,0,10"/>

            <Button Grid.Row="1" Grid.Column="0" Content="7" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Content="/"/>

            <Button Grid.Row="2" Grid.Column="0" Content="4" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Content="*"/>

            <Button Grid.Row="3" Grid.Column="0" Content="1" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="3" Grid.Column="3" Content="-"/>

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" MinWidth="40" Click="NumberButton_Click"/>
            <Button Grid.Row="4" Grid.Column="2" Content="C" Click="Clear_Click"/>
            <Button Grid.Row="4" Grid.Column="3" Content="+"/>
        </Grid>

    </DockPanel>

</Window>
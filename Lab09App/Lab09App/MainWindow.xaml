<Window x:Class="Lab09App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lab09App"
        Title="Список задач" Height="420" Width="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToBrushConverter x:Key="BoolToBrush"/>
        <local:DateToRelativeStringConverter x:Key="DateToRelative"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: ввод, приоритет, кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBox x:Name="InputBox" Width="180"/>
            <ComboBox x:Name="PriorityBox" Width="60" SelectedIndex="0" Margin="4,0">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
            </ComboBox>
            <Button Content="Добавить"
            Command="{Binding AddCommand}"/>
            <Button Content="Удалить"
            Command="{Binding DeleteCommand}"
            CommandParameter="{Binding SelectedItem, ElementName=TaskList}"
            Margin="4,0,0,0"/>
            <Button Content="Отметить выполненной"
            Command="{Binding MarkDoneCommand}"
            CommandParameter="{Binding SelectedItem, ElementName=TaskList}"
            Margin="4,0,0,0"/>
        </StackPanel>

        <!-- Список задач -->
        <ListBox x:Name="TaskList" Grid.Row="1" Margin="0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsDone}"
                                  Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}"
                                   Margin="0,0,8,0"
                                   Foreground="{Binding IsDone,
                                       Converter={StaticResource BoolToBrush}}"/>

                        <!-- Индикатор приоритета -->
                        <TextBlock Text="{Binding Priority, StringFormat='[{0}]'}"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Priority}" Value="1">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="2">
                                            <Setter Property="Foreground" Value="Goldenrod"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="3">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Дата создания: сегодня / вчера / N дней назад -->
                        <TextBlock Text="{Binding CreatedAt,
                                  Converter={StaticResource DateToRelative}}"
                                   Margin="8,0,0,0"
                                   Foreground="#666666"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Нижняя надпись: счётчик + процент -->
        <TextBlock x:Name="CounterText" Grid.Row="2" FontWeight="Bold"/>

    </Grid>
</Window>
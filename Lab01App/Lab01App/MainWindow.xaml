<Window x:Class="Lab01App.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Первое приложение" Height="260" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">
        <TextBlock Text="Введите имя:"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,10"/>
        <Button Content="Приветствовать" Click="Button_Click" IsDefault="True"/>
        <Button Content="Очистить" Click="Button_Clear" Margin="0,5,0,0"/>
        <Button Content="Закрыть" Click="Button_Close" Margin="0,5,0,0" IsCancel="True"/>
        <TextBlock x:Name="ResultText" Margin="0,10,0,0"
                   FontWeight="Bold" Foreground="#2D6CB5"/>
    </StackPanel>

</Window>

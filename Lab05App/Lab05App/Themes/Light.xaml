<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBrush"     Color="#2868B2"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4F8A"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#C7463B"/>

    <SolidColorBrush x:Key="HeaderBrush"      Color="#1D4F8A"/>
    <SolidColorBrush x:Key="LabelBrush"       Color="#344054"/>

    <SolidColorBrush x:Key="WindowBackground" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="InputBackground"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForeground"  Color="#17212B"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#AAB7C6"/>
    <SolidColorBrush x:Key="DisabledBrush"    Color="#AAB4C0"/>

    <SolidColorBrush x:Key="CheckBoxForeground" Color="#344054"/>

</ResourceDictionary>